[Unit]
Description=Download and verify s4lockdown kernel updates
Documentation=https://github.com/xiaoyueyoqwq/secure-hibernate-kernel
Wants=network-online.target
After=network-online.target
Before=s4lockdown-update.service

[Service]
Type=oneshot
User=s4lockdown-update
Group=s4lockdown-update
CacheDirectory=s4lockdown-update
CacheDirectoryMode=0750
ExecStart=/usr/local/lib/s4lockdown-update/scripts/update-local.sh check
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
