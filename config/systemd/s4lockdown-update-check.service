[Unit]
Description=Download and verify s4lockdown kernel updates
Documentation=https://github.com/xiaoyueyoqwq/secure-hibernate-kernel
Wants=network-online.target
After=network-online.target
Before=s4lockdown-update.service

[Service]
Type=oneshot
User=s4lockdown-update
Group=s4lockdown-update
CacheDirectory=s4lockdown-update
# Only JSON status reports are mode 0644; staged package directories remain mode 0700.
CacheDirectoryMode=0755
ExecStart=/usr/local/lib/s4lockdown-update/scripts/update-local.sh check
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/s4lockdown-update/update.lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
# dpkg-deb invokes tar while validating the signed package. tar must be able
# to restore package mode metadata inside its private temporary directory;
# RestrictSUIDSGID makes those calls fail with ENOSYS. This service remains
# unprivileged and never executes files from the extraction directory.
SystemCallArchitectures=native
